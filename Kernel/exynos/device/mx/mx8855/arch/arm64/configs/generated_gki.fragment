# CONFIG_SAMSUNG_PRODUCT_SHIP is not set
# CONFIG_KNOX_NCM is not set
# CONFIG_SECURITY_KUMIHO is not set
# CONFIG_SECURITY_SEATD is not set
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_SECURITY_DSMS is not set
CONFIG_SMB_SERVER=y
CONFIG_SMB_SERVER_CHECK_CAP_NET_ADMIN=y
CONFIG_CIFS=y
# CONFIG_CIFS_ALLOW_INSECURE_LEGACY is not set
CONFIG_CIFS_DEBUG2=y
# CONFIG_FIVE is not set
# CONFIG_PROCA is not set
CONFIG_GAF=y
CONFIG_GAF_V6=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NLS=y

# Linux / Ubuntu userspace and systemd support
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_VT=y
CONFIG_VETH=y
