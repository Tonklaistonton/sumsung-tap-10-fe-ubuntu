#include <linux/proc_fs.h>


#include "abox_dbg.h"
#include "abox_oem.h"
#include "abox_proc.h"

static struct device *abox_oem_dev_abox;
static struct abox_data *abox_oem_abox_data;
int noise_type;

static ssize_t abox_oem_resize_reserved_memory_dbg(void)
{
	ssize_t size = -ENODEV;

	/* SAMPLE CODE - START*/
#if IS_ENABLED(CONFIG_SND_SOC_SAMSUNG_ABOX_CHANGE_RMEM_SIZE)
	if (check_upload_mode_disabled())
		size = get_rmem_size_min(TYPE_ABOX_DBG_SIZE);
#endif
	/* SAMPLE CODE - END */
	/* TO DO: Delete upper code and implement OEM specific code */

	return size;
}

static ssize_t abox_oem_resize_reserved_memory_slog(void)
{
	ssize_t size = -ENODEV;

	/* SAMPLE CODE - START */
#if IS_ENABLED(CONFIG_SND_SOC_SAMSUNG_ABOX_CHANGE_RMEM_SIZE)
	if (check_debug_level_low())
		size = get_rmem_size_min(TYPE_ABOX_SLOG_SIZE);
#endif
	/* SAMPLE CODE - END */
	/* TO DO: Delete upper code and implement OEM specific code */

	return size;
}

ssize_t abox_oem_resize_reserved_memory(enum ABOX_OEM_RESERVED_MEMORY type)
{
	ssize_t size = -ENODEV;

	switch (type) {
	case ABOX_OEM_RESERVED_MEMORY_DBG:
		size = abox_oem_resize_reserved_memory_dbg();
		break;
	case ABOX_OEM_RESERVED_MEMORY_SLOG:
		size = abox_oem_resize_reserved_memory_slog();
		break;
	}

	return size;
}

static ssize_t abox_oem_read(struct file *file,
		char __user *data, size_t count, loff_t *ppos)
{
	int len;
	char buffer[64];

	/* make sure offline is updated prior to wake up */
	rmb();
	len = snprintf(buffer, sizeof(buffer), "%d\n", noise_type);
	noise_type = -1;
	return simple_read_from_buffer(data, count, ppos, buffer, len);
}

static __poll_t abox_oem_poll(struct file *file, poll_table *wait)
{
	poll_wait(file, &abox_oem_abox_data->noise_detection_wait, wait);

	if (noise_type >= 0)
		return POLLIN | POLLPRI | POLLRDNORM;
	else
		return 0;
}

static int abox_oem_release(struct inode *i, struct file *f)
{
	wake_up_interruptible(&abox_oem_abox_data->noise_detection_wait);
	return 0;
}

static const struct proc_ops abox_oem_online_fops = {
	.proc_read = abox_oem_read,
	.proc_lseek = default_llseek,
	.proc_poll = abox_oem_poll,
	.proc_release = abox_oem_release,
};

void abox_oem_init(struct device *dev)
{
	struct proc_dir_entry *dir, *ret_dir;

	abox_oem_dev_abox = dev;
	abox_oem_abox_data = (struct abox_data *)dev_get_drvdata(dev);
	noise_type = -1;

	dir = abox_proc_mkdir("oem", NULL);

	ret_dir = abox_proc_create_file("noise", 0660,
			dir, &abox_oem_online_fops, dev, 0);
	if (IS_ERR_OR_NULL(ret_dir))
		dev_warn(dev, "%s: %s file creation failed: %ld\n",
				__func__, "noise", PTR_ERR(ret_dir));
}

void abox_oem_noise_detect(struct abox_data *data, struct IPC_SYSTEM_MSG *system_msg,
	enum ABOX_OEM_NOISE_TYPE type)
{
	/*TO DO: implement OEM specific code*/
	/*
	if (system_msg) {
		system_msg->param1: ABOX_OEM_NOISE_TYPE
		system_msg->bundle.param_s32[0]: channel id
		system_msg->bundle.param_s32[1]: underrun count, rms value
		system_msg->bundle.param_s32[2]: interval (ms)
	}
	*/
	if (type < 0 || type > ABOX_OEM_NOISE_TYPE_COUNT) {
		dev_info(data->dev, "%s, invaild noise type:%d\n", __func__, type);
		return;
	}
	noise_type = type;
	wake_up_interruptible(&abox_oem_abox_data->noise_detection_wait);
	dev_info(data->dev, "%s: %d\n", __func__, type);
}
